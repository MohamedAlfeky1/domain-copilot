# ==============================================================================
# DOMAIN COPILOT CONFIGURATION (.env.example)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Assessment Variant Lock (MUST match invitation email or National ID derivation)
ASSIGNED_DOMAIN=D0_HEALTHCARE
ASSIGNED_TWIST=T1_BILINGUAL_AR_EN

# AI Provider Configuration (Step 5 - Multi-Provider Selection Layer)
# Supported LLM providers: openai, openrouter, ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Local LLM Configuration (Active when AI_PROVIDER=ollama)
# NOTE FOR DOCKER: From inside Docker containers, localhost refers to the container itself.
# To reach Ollama on the host machine from inside Docker, set OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false

# OpenRouter Configuration (Required when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding Provider Configuration (Step 6 - Independent Embedding Provider)
# Supported embedding providers: openai, gemini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Database Configuration (External Postgres / pgvector or Embedded)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_copilot
USE_EMBEDDED_DB=true

# Security & JWT Secret
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3000

# OCR Configuration (Step 3 - Optional Fallback for Scanned PDFs)
OCR_ENABLED=false
OCR_BINARY_PATH=tesseract
OCR_LANGUAGES=ara+eng
OCR_TIMEOUT_MS=60000
